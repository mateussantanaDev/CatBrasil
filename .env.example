# Produção: copie para .env e preencha valores exclusivos. Não use o sandbox.
# APP_ENV=production exige PIX_MODE=suitpay, gateway SMS HTTPS e credenciais SuitPay no ERP.
APP_ENV=production
PIX_MODE=suitpay
DB_NAME=catbrasil
DB_USER=catadmin
DB_PASSWORD=
DB_PORT=5432
API_PORT=8080
CLIENT_PORT=3000
ADMIN_PORT=3002
GOMAXPROCS=2
DATABASE_URL=postgres://catadmin:<senha_url_encoded>@postgres:5432/catbrasil?sslmode=disable
JWT_SECRET=
PIX_WEBHOOK_SECRET=
ADMIN_SECRET_PIN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_CODE_SECRET=
IDENTITY_SECRET=
SUITPAY_LIVE_ENABLED=false
OBSERVABILITY_TOKEN=
# PIX_SANDBOX_URL é aplicado somente no override de staging; mantenha vazio em produção.
PIX_SANDBOX_URL=
# O gateway recebe POST JSON {"phone":"+5511999999999","message":"..."} com Authorization: Bearer <SMS_GATEWAY_TOKEN>.
CORS_ALLOWED_ORIGINS=
CLIENT_DOMAIN=
ADMIN_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
# Frontends usam /api/v1 e WebSocket na origem atual, via proxy Caddy.
