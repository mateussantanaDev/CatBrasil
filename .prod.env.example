# .prod.env.example
# Modelo de variáveis de ambiente para deploy de produção (Greenfield)
# Copie para .prod.env e defina credenciais seguras e exclusivas.
#
# AVISO: Nunca execute produção sem o overlay compose.prod.yml.
# SUITPAY_LIVE_ENABLED deve permanecer "false" até aprovação de P0.2 a P0.6.

APP_ENV=production
PIX_MODE=suitpay
DB_NAME=catbrasil_prod
DB_USER=catadmin
DB_PASSWORD=
DB_PORT=5432
API_PORT=8080
# A API não publica esta porta no overlay de produção. O proxy confiável é fixado no Compose.
CLIENT_PORT=3000
ADMIN_PORT=3002
GOMAXPROCS=2
DATABASE_URL=postgres://catadmin:<senha_url_encoded>@postgres:5432/catbrasil_prod?sslmode=disable
JWT_SECRET=
PIX_WEBHOOK_SECRET=
ADMIN_SECRET_PIN=
BOOTSTRAP_ADMIN_USERNAME=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_CODE_SECRET=
IDENTITY_SECRET=
SUITPAY_LIVE_ENABLED=false
OBSERVABILITY_TOKEN=
PIX_SANDBOX_URL=
CORS_ALLOWED_ORIGINS=
CLIENT_DOMAIN=
ADMIN_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# Destino self-hosted externo à stack. HTTPS público ou VPN com certificado válido.
# A configuração é obrigatória no corte; use um tópico exclusivo e controle acesso.
NTFY_URL=
NTFY_TOKEN=
# Host de restauração independente acessível por IP privado (RFC1918 ou CGNAT):porta.
RECOVERY_NODE_EXPORTER_TARGET=

# --- P0.6: Portão de Evidências do Corte (somente cutover_orchestrator.sh --execute) ---
# Nenhum valor real abaixo. Sem estes itens o corte é recusado com exit 3 (fail-closed).
# Identidade do operador assinante; DEVE ser a mesma identidade da assinatura OpenSSH
# (principals do allowed_signers) e DISTINTA do revisor de p0_4_identity_sms.
CUTOVER_OPERATOR=
# Manifesto JSON de evidências (pode ser caminho absoluto fora do repositório).
CUTOVER_EVIDENCE_MANIFEST=release_evidence/p0_cutover_evidence.json
# Arquivo allowed_signers DEVE ficar FORA do repositório (formato: <principal> <tipo> <chave>).
# Ex.: operador-corte ssh-ed25519 AAAA...
CUTOVER_ALLOWED_SIGNERS=/etc/catbrasil-release/allowed_signers
# Assinatura OpenSSH detached do manifesto (padrão: <manifesto>.sig);
# crie com: ssh-keygen -Y sign -f <chave_privada> -n catbrasil:release:evidence-manifest:v1 <manifesto>
CUTOVER_EVIDENCE_SIGNATURE=
# Cada item do manifesto precisa apontar para um arquivo de evidência REAL fora do
# repositório com sha256 conferido; a assinatura prova identidade de aprovação,
# não a verdade do conteúdo das evidências.

# --- P0.6: Imagens imutáveis do corte (sem valores reais) ---
# Digests sha256 em hex minúsculo (64 caracteres), obtidos ANTES do corte, ex.:
#   docker buildx imagetools inspect postgres:16-alpine --format '{{json .Manifest.Digest}}'
POSTGRES_IMAGE_DIGEST=
CADDY_IMAGE_DIGEST=
PROMETHEUS_IMAGE_DIGEST=
ALERTMANAGER_IMAGE_DIGEST=
NODE_EXPORTER_IMAGE_DIGEST=
# Imagens de build publicadas no registry, formato repo@sha256:<64 hex> (nunca tags mutáveis).
PROD_BACKEND_MIGRATE_IMAGE=
PROD_BACKEND_API_IMAGE=
PROD_BACKEND_CRON_IMAGE=
PROD_APP_CLIENT_IMAGE=
PROD_APP_ADMIN_IMAGE=
PROD_ALERT_RELAY_IMAGE=
