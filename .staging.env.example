# Copie para .staging.env (ignorado pelo Git) e gere valores aleatórios exclusivos.
# Use somente em máquina privada; o override força APP_ENV=staging e PIX_MODE=suitpay.
APP_ENV=staging
PIX_MODE=suitpay
DB_NAME=catbrasil_staging
DB_USER=catadmin_staging
GOMAXPROCS=2
DB_PASSWORD=
DATABASE_URL=postgres://catadmin_staging:<senha_url_encoded>@postgres:5432/catbrasil_staging?sslmode=disable
JWT_SECRET=
PIX_WEBHOOK_SECRET=
ADMIN_SECRET_PIN=
SMS_GATEWAY_TOKEN=
SMS_CODE_SECRET=
IDENTITY_SECRET=
SMS_SANDBOX_INSPECT_TOKEN=
PIX_SANDBOX_CLIENT_ID=staging-client
PIX_SANDBOX_CLIENT_SECRET=
PIX_SANDBOX_INSPECT_TOKEN=
OBSERVABILITY_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://admin.localhost:8088
CLIENT_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost
API_DOMAIN=api.localhost
ACME_EMAIL=staging@localhost
# URLs publicadas só em 127.0.0.1 pelo override de staging.
STAGING_HTTP_PORT=8088
SMS_SANDBOX_PORT=18081
PIX_SANDBOX_PORT=18082
STAGING_PROMETHEUS_PORT=19090
