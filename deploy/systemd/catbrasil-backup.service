[Unit]
Description=CatBrasil encrypted PostgreSQL backup to verified remote mount
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/catbrasil/backup.env
ExecStart=/usr/bin/python3 /opt/catbrasil/current/scripts/release/backup-automation.py backup
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

