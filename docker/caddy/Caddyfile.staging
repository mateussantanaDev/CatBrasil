# Acessível apenas pela porta loopback do compose.staging.yml.
{
    admin off
}

http://localhost {
    encode gzip zstd
    handle /internal/* {
        respond "Not found" 404
    }
    handle /api/* {
        reverse_proxy api-proxy:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle /health {
        reverse_proxy api-proxy:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle /ready {
        reverse_proxy api-proxy:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        reverse_proxy app-client:80
    }
}

http://admin.localhost {
    encode gzip zstd
    handle /internal/* {
        respond "Not found" 404
    }
    handle /api/* {
        reverse_proxy api-proxy:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle /health {
        reverse_proxy api-proxy:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle /ready {
        reverse_proxy api-proxy:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        reverse_proxy app-admin:80
    }
}

http://api.localhost {
    encode gzip zstd
    handle /internal/* {
        respond "Not found" 404
    }
    handle {
        reverse_proxy api-proxy:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }
}

:80 {
    respond "Unknown host" 404
}
