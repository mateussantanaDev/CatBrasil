# ==============================================================================
# Stage 1: Builder (Node.js 22 Alpine)
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Instala dependências do monorepo
COPY frontend/package*.json ./
COPY frontend/apps/client/package*.json ./apps/client/
COPY frontend/apps/admin/package*.json ./apps/admin/
COPY frontend/packages/types/package*.json ./packages/types/
COPY frontend/packages/ui/package*.json ./packages/ui/

RUN npm install

# Copia o código fonte do frontend
COPY frontend/ .

# Compilação otimizada do ERP admin com Vite
RUN npm --workspace=@catbrasil/admin run build
RUN node scripts/check-bundle-urls.mjs apps/admin/dist

# ==============================================================================
# Stage 2: Nginx Alpine Runtime Mínimo (< 20MB)
# ==============================================================================
FROM nginx:1.27-alpine

# Copia os arquivos compilados do dist
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html

# Copia a configuração Nginx
COPY docker/nginx/nginx-admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1/healthz"]

CMD ["nginx", "-g", "daemon off;"]
